# ─── ЧАРО Server — Environment Variables ───────────────────────────
# Скопируй в .env и заполни значениями

# Server
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Database (Neon PostgreSQL — бесплатно, без карты)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Redis (Upstash — бесплатно, без карты)
REDIS_URL=rediss://default:password@endpoint.upstash.io:6379
REDIS_HOST=endpoint.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=your-upstash-password

# JWT (сгенерировать: openssl rand -hex 32)
JWT_ACCESS_SECRET=заменить-на-64-hex-символа
JWT_REFRESH_SECRET=заменить-на-64-hex-символа
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# CORS
CORS_ORIGINS=*

# MinIO / Object Storage (опционально — без него медиа вернёт 503)
MINIO_ENDPOINT=
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=charo-media
CDN_BASE_URL=

# AI (опционально)
GEMINI_API_KEY=

# Logging
LOG_LEVEL=info

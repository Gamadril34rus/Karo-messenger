# ─── ЧАРО Server Configuration ──────────────────────────────────

# PostgreSQL
DATABASE_URL=postgresql://charo:charo_password@localhost:5432/charo_messenger

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (change in production!)
JWT_ACCESS_SECRET=charo-access-secret-change-me-in-production
JWT_REFRESH_SECRET=charo-refresh-secret-change-me-in-production

# CORS
CORS_ORIGINS=https://charo.chat,https://app.charo.chat,http://localhost:3000

# Server
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info

# SMS Provider (SMSAero / Twilio)
SMS_PROVIDER=smsaero
SMS_API_KEY=
SMS_FROM=Charo

# Email Provider (Resend / SendGrid)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=noreply@charo.chat

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
OAUTH_REDIRECT_URL=https://app.charo.chat/auth/callback

# CDN / MinIO
CDN_BASE_URL=https://cdn.charo.chat
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=charo-media

# Mirror Domains (anti-blocking)
MIRROR_DOMAINS=https://m1.charo.chat,https://m2.charo.chat,https://m3.charo.chat

# AI (Google Gemini)
GEMINI_API_KEY=

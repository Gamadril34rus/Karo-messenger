# ─── ЧАРО — Environment Variables ────────────────────────
# Скопируйте этот файл в .env и заполните значения

# ─── Сервер ────────────────────────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug

# ─── База данных (PostgreSQL) ──────────────────────────────────────
DATABASE_URL=postgresql://charo:charo_dev_password@localhost:5432/charo_messenger
POSTGRES_PASSWORD=charo_dev_password

# ─── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=charo_dev_password

# ─── JWT ───────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_at_least_64_chars
JWT_REFRESH_SECRET=change_me_to_another_long_random_string_at_least_64_chars

# ─── MinIO (S3 хранилище файлов) ───────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=charo_admin
MINIO_SECRET_KEY=charo_dev_password
MINIO_BUCKET=charo-media
MINIO_ROOT_USER=charo_admin
MINIO_ROOT_PASSWORD=charo_dev_password

# ─── ClickHouse (Аналитика) ────────────────────────────────────────
CLICKHOUSE_PASSWORD=charo_dev_password

# ─── Meilisearch (Поиск) ──────────────────────────────────────────
MEILI_MASTER_KEY=charo_dev_key

# ─── SMS провайдер ─────────────────────────────────────────────────
SMS_PROVIDER=smsaero  # smsaero | twilio | smshub
SMSAERO_EMAIL=your@email.com
SMSAERO_API_KEY=your_api_key
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Email ─────────────────────────────────────────────────────────
EMAIL_PROVIDER=resend  # resend | sendgrid
RESEND_API_KEY=your_api_key
SENDGRID_API_KEY=your_api_key

# ─── OAuth ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
OAUTH_REDIRECT_URL=http://localhost:3000/api/v1/auth/oauth/callback

# ─── Push-уведомления ──────────────────────────────────────────────
FCM_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=

# ─── AI ────────────────────────────────────────────────────────────
AI_PROVIDER=google  # google | openai | anthropic
GOOGLE_AI_API_KEY=your_api_key
OPENAI_API_KEY=your_api_key
ANTHROPIC_API_KEY=your_api_key

# ─── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5000

# ─── CDN ───────────────────────────────────────────────────────────
CDN_URL=https://cdn.charo.chat
CDN_MIRROR_1=https://cdn1.charo.chat
CDN_MIRROR_2=https://cdn2.charo.chat

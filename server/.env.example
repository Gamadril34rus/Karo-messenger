# ─── ЧАРО (Charo) Server Configuration ──────────────────────────
# Copy this file to .env and fill in your values

# Server
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://charo:charo_secret@localhost:5432/charo

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-random-string-at-least-32-chars

# MinIO (S3-compatible media storage)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=charo-media

# CDN
CDN_BASE_URL=http://localhost:9000/charo-media

# SMS (optional — for OTP delivery)
SMS_PROVIDER=smsaero
SMS_API_KEY=
SMS_FROM=Charo

# Email (optional — for OTP and email verification)
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=noreply@charo.chat

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
OAUTH_REDIRECT_URL=http://localhost:3000/api/v1/auth/oauth/callback

# TURN (for WebRTC calls)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

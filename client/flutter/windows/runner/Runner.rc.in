#include "resource.h"

#define APSTUDIO_READONLY_SYMBOLS
#include "afxres.h"
#undef APSTUDIO_READONLY_SYMBOLS

#if !defined(AFX_RESOURCE_DLL)
LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

#ifdef APSTUDIO_INVOKED
1 TEXTINCLUDE
BEGIN
    "resource.h\0"
END

2 TEXTINCLUDE
BEGIN
    "#include ""afxres.h""\r\n"
    "\0"
END

3 TEXTINCLUDE
BEGIN
    "\r\n"
    "\0"
END
#endif

IDR_APP_ICON ICON "resources/app_icon.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,1,0,2
PRODUCTVERSION 1,1,0,2
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Charo Team"
            VALUE "FileDescription", "@RESOURCES_APP_NAME@"
            VALUE "FileVersion", "1.1.0.2"
            VALUE "InternalName", "@RESOURCES_APPLICATION_ID@"
            VALUE "LegalCopyright", "© 2024 Charo Team"
            VALUE "OriginalFilename", "charo_messenger.exe"
            VALUE "ProductName", "@RESOURCES_APP_NAME@"
            VALUE "ProductVersion", "1.1.0.2"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END

#endif
